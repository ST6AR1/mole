---
// The brand-memory beat: lots of whitespace, one small piece of motion.
// No feature copy here on purpose — see mole-site-plan.md section 05.
import type { Dictionary } from "../i18n/types";
import MoleArt from "./MoleArt.astro";

interface Props {
  dict: Dictionary;
}
const { dict } = Astro.props;
---

<section class="mole-moment section">
  <div class="container scene-wrap reveal">
    <div class="folder-row" aria-hidden="true">
      <MoleArt pose="folder" width={40} alt="" decorative class="folder-img folder-a" />
      <MoleArt pose="folder" width={40} alt="" decorative class="folder-img folder-b" />
      <MoleArt pose="folder" width={40} alt="" decorative class="folder-img folder-c" />
    </div>

    <div class="mound-stack" aria-hidden="true">
      {/* Looping GIF the maker made of the full dig cycle. Swapped for a
         static "popped up" frame under prefers-reduced-motion (CSS below). */}
      <MoleArt pose="dig-loop" width={220} alt="" decorative class="dig-motion" />
      <MoleArt pose="dig-1" width={220} alt="" decorative class="dig-still" loading="eager" />
    </div>

    <div class="moment-copy">
      <p class="muted">{dict.moleMoment.line1}</p>
      <p class="muted">{dict.moleMoment.line2}</p>
      <p class="moment-emph">{dict.moleMoment.line3}</p>
    </div>
  </div>
</section>

<style>
  .mole-moment {
    background: var(--surface-warm);
  }

  .scene-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--sp-12);
  }

  .folder-row {
    position: relative;
    width: min(520px, 90%);
    height: 44px;
  }

  /* :global() — MoleArt's <img> lives outside this file's style scope.
     Each folder drops and fades on a loop, as if being handed down to
     Mole underground; staggered delays keep them from falling in sync. */
  .folder-row :global(.folder-img) {
    position: absolute;
    top: 0;
    filter: drop-shadow(0 4px 6px rgba(30, 29, 27, 0.12));
    transform: translateY(0) rotate(var(--rot, 0deg));
    animation: folder-drop 3.6s ease-in infinite;
  }

  .folder-row :global(.folder-a) {
    left: 8%;
    --rot: -8deg;
    animation-delay: 0s;
  }
  .folder-row :global(.folder-b) {
    left: 46%;
    top: -10px;
    --rot: 5deg;
    animation-delay: 1.1s;
  }
  .folder-row :global(.folder-c) {
    left: 80%;
    --rot: -4deg;
    animation-delay: 2.2s;
  }

  @keyframes folder-drop {
    0%,
    35% {
      opacity: 1;
      transform: translateY(0) rotate(var(--rot, 0deg));
    }
    85%,
    100% {
      opacity: 0;
      transform: translateY(56px) rotate(var(--rot, 0deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-row :global(.folder-img) {
      animation: none;
      opacity: 1;
    }
  }

  .mound-stack {
    position: relative;
    width: 220px;
    height: 170px;
  }

  .mound-stack :global(img) {
    position: absolute;
    inset: 0;
    margin-inline: auto;
  }

  .mound-stack :global(.dig-still) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mound-stack :global(.dig-motion) {
      display: none;
    }
    .mound-stack :global(.dig-still) {
      display: block;
    }
  }

  .moment-copy p {
    font-size: var(--fs-h3);
  }

  .moment-emph {
    color: var(--text);
    font-weight: 700;
    margin-top: var(--sp-2);
  }

  @media (max-width: 640px) {
    .mound-stack {
      width: 170px;
      height: 132px;
    }
  }
</style>
