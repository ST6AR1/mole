---
import type { Dictionary } from "../i18n/types";
import type { ReleaseInfo } from "../data/release";
import MoleArt from "./MoleArt.astro";
import { withBase, REPO_URL, RELEASES_URL, LICENSE_URL } from "../utils/url";

interface Props {
  dict: Dictionary;
  release: ReleaseInfo;
}
const { dict, release } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <a href={withBase("/")} class="footer-brand">
        <MoleArt pose="wordmark-logo" width={130} alt="Mole" />
      </a>

      <nav class="footer-links" aria-label="Footer">
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer">{dict.footer.github}</a>
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">{dict.footer.download}</a>
        <a href={withBase("/changelog")}>{dict.footer.changelog}</a>
        <a href={withBase("/contact")}>{dict.footer.contact}</a>
        <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer">{dict.footer.license}</a>
        <a href={withBase("/privacy")}>{dict.footer.privacy}</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="muted">{dict.footer.credit}</p>
      <p class="footer-version muted">
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">v{release.version}</a>
      </p>
    </div>

    <MoleArt
      pose="pawprints"
      width={72}
      alt=""
      decorative
      class="footer-prints"
    />
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--sp-16) var(--sp-8);
    position: relative;
    overflow: hidden;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-6);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text);
  }

  .footer-brand :global(img) {
    height: 26px;
    width: auto;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
  }

  .footer-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .footer-bottom a {
    text-decoration: none;
  }

  /* :global() — MoleArt's <img> lives outside this file's style scope. */
  .footer-inner :global(.footer-prints) {
    align-self: flex-end;
    margin-inline-start: auto;
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .footer-top,
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
