---
import type { Dictionary } from "../i18n/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { REPO_URL, RELEASES_URL } from "../utils/url";
import { readyLocales } from "../i18n/config";
import MoleArt from "./MoleArt.astro";

interface Props {
  dict: Dictionary;
  locale: string;
  routePath: string; // current page's locale-agnostic route, e.g. "/support" — lets the language switcher stay on the same page
}
const { dict, locale, routePath } = Astro.props;
const homeHref = getRelativeLocaleUrl(locale, "/");
---

<header class="site-header" id="site-header">
  <div class="container container--wide header-inner">
    <a href={homeHref} class="brand" aria-label="Mole home">
      <MoleArt pose="wordmark-logo" width={160} alt="Mole" class="brand-mark" />
    </a>

    <nav class="nav" aria-label="Primary">
      <a href={`${homeHref}#features`}>{dict.nav.features}</a>
      <a href={getRelativeLocaleUrl(locale, "/changelog")}>{dict.nav.changelog}</a>
      <a href={getRelativeLocaleUrl(locale, "/support")}>{dict.nav.support}</a>
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer"
        >{dict.nav.github}</a
      >
    </nav>

    <div class="header-right">
      <div class="lang-switch">
        <select class="lang-select" aria-label="Language" data-lang-select>
          {
            readyLocales.map((l) => (
              <option value={getRelativeLocaleUrl(l.code, routePath)} selected={l.code === locale}>
                {l.label}
              </option>
            ))
          }
        </select>
        <svg class="lang-chevron" viewBox="0 0 20 20" width="12" height="12" aria-hidden="true">
          <path d="M5 7.5L10 12.5L15 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <a href={RELEASES_URL} class="header-cta" target="_blank" rel="noopener noreferrer">
        {dict.nav.download}
      </a>
    </div>
  </div>
</header>

<script>
  // Native <select> as the language dropdown: each option's value is the
  // full URL for the same page in that locale, so switching is just a
  // navigation. Scoped to this component's own selects so multiple Header
  // instances (there's only ever one, but just in case) don't double-bind.
  document.querySelectorAll<HTMLSelectElement>("[data-lang-select]").forEach((select) => {
    select.addEventListener("change", () => {
      const url = select.value;
      if (url) window.location.href = url;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--border);
    box-shadow: 0 4px 16px -12px rgba(30, 29, 27, 0.2);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    height: 72px;
    transition: height var(--dur-med) var(--ease-out);
  }

  .is-scrolled .header-inner {
    height: 56px;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--text);
  }

  /*
    MoleArt renders an <Image> from a *different* .astro file, so it never
    carries this component's data-astro-cid scope attribute — a plain
    `.brand-mark { … }` rule would silently never match. `:global()` opts
    that one class out of scoping. Same pattern everywhere else in this
    codebase that styles a MoleArt/Screenshot/Button child by class.
  */
  .brand :global(.brand-mark) {
    height: 40px;
    width: auto;
    transition: height var(--dur-med) var(--ease-out);
  }

  .is-scrolled .brand :global(.brand-mark) {
    height: 30px;
  }

  .nav {
    display: flex;
    gap: var(--sp-6);
    margin-inline-start: var(--sp-6);
    flex: 1;
  }

  .nav a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav a:hover {
    color: var(--text);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-inline-start: auto;
  }

  .lang-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .lang-select {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    padding: 0.4em 1.75em 0.4em 0.9em;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .lang-select:hover {
    color: var(--text);
    border-color: var(--soil-light);
  }

  .lang-chevron {
    position: absolute;
    right: 0.65em;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-faint);
    pointer-events: none;
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5em 1.25em;
    border-radius: var(--radius-pill);
    background: var(--soil);
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .header-cta:hover {
    background: var(--soil-hover);
    transform: translateY(1px);
  }

  @media (max-width: 640px) {
    .nav {
      display: none;
    }
    .header-inner {
      height: 60px;
    }
    .is-scrolled .header-inner {
      height: 52px;
    }
    .header-right {
      gap: var(--sp-3);
    }
    .lang-select {
      font-size: 0.75rem;
      padding: 0.35em 1.6em 0.35em 0.75em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-inner,
    .brand-mark,
    .header-cta {
      transition: none;
    }
  }
</style>
