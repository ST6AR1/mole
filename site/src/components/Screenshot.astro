---
// Swappable "App UI" slot used across the Hero, Solution, and Features
// sections. Every real screenshot request in mole-site-plan.md maps to one
// `scene` value here. Once a real capture exists:
//
//   import running3 from "../assets/screenshots/running-3.png";
//   <Screenshot scene="running" src={running3} alt="Mole showing three running projects" />
//
// The `src` image replaces the placeholder mock automatically — no other
// markup on the page needs to change.
//
// The mock below is modeled on real screenshots of the shipped app (Sept
// 2026), not invented from scratch: the drop zone shows the carry-folder
// mascot (not a bare folder icon), a small mole rides in the toolbar
// corner, the empty Running Projects state is a mound + "zzz···", and
// "Analyzing project" shows the mole popped up out of the ground.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import MoleArt from "./MoleArt.astro";

export type Scene =
  | "default"
  | "hover"
  | "detecting"
  | "running"
  | "update-banner"
  | "settings";

interface Props {
  scene: Scene;
  src?: ImageMetadata;
  alt: string;
  priority?: boolean;
  class?: string;
}

const { scene, src, alt, priority = false, class: className } = Astro.props;

const showDropZone = scene === "default" || scene === "hover" || scene === "update-banner";
const showEmptyRunning = scene === "default";
---

<figure class:list={["app-frame", className]} data-scene={scene}>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        loading={priority ? "eager" : "lazy"}
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 60vw, 520px"
      />
    ) : (
      <div class="mock" role="img" aria-label={alt}>
        <div class="mock-titlebar">
          <span class="tl tl-red" aria-hidden="true"></span>
          <span class="tl tl-yellow" aria-hidden="true"></span>
          <span class="tl tl-green" aria-hidden="true"></span>
          <span class="mock-word">mole</span>
          <span class="mock-tag">Skip the commands, get to work.</span>
          <MoleArt pose="wrench" width={26} alt="" decorative class="mock-corner-mole" />
        </div>

        {scene === "update-banner" && (
          <div class="mock-banner">
            <span>Mole has a new version</span>
            <span class="mock-banner-ver">v1.0.3 → v1.0.4</span>
            <span class="mock-banner-cta">View Update</span>
          </div>
        )}

        <div class="mock-body">
          {showDropZone && (
            <div class="drop-zone-wrap">
              <span class="doodle drag-doodle">drag it!</span>
              <svg class="drag-arrow" viewBox="0 0 60 40" width="52" height="34" aria-hidden="true">
                <path d="M52 6 C 40 4, 20 10, 10 28" fill="none" stroke="var(--soil-light)" stroke-width="1.5" stroke-linecap="round" />
                <path d="M4 22 L10 28 L16 21" fill="none" stroke="var(--soil-light)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>

              <div class:list={["drop-zone", { "is-hover": scene === "hover" }]}>
                <MoleArt
                  pose="carry-folder"
                  width={76}
                  alt=""
                  decorative
                  class="drop-mole"
                />
                <p class="drop-title">{scene === "hover" ? "Drop it here" : "Drop your project folder here"}</p>
                <p class="drop-sub muted">
                  {scene === "hover" ? "Got it!" : "No commands to remember — I'll figure it out"}
                </p>
                {scene !== "hover" && <span class="pill-btn">Choose Folder</span>}
              </div>

              <MoleArt pose="pawprints" width={44} alt="" decorative class="drop-prints" />
            </div>
          )}

          {scene === "detecting" && (
            <div class="detect-card">
              <MoleArt pose="dig-1" width={64} alt="" decorative class="detect-mole" />
              <div class="detect-text">
                <p class="detect-title">Analyzing project</p>
                <p class="detect-sub muted">Let's see what's in this folder</p>
                <ul class="detect-list">
                  <li class="done">Project type <b>Vite</b></li>
                  <li class="done">Package manager <b>npm</b></li>
                  <li class="pending">Finding an open port</li>
                  <li class="pending">Starting localhost</li>
                </ul>
              </div>
            </div>
          )}

          {showEmptyRunning && (
            <div class="autoclose-row">
              <div class="autoclose-label">
                <span>Auto Close</span>
                <span class="muted">Idle projects will close automatically</span>
              </div>
              <span class="dropdown-pill">2 hours (default) <span aria-hidden="true">⌄</span></span>
            </div>
          )}

          {(showEmptyRunning || scene === "running") && (
            <div class="row-head">
              <span>Running Projects</span>
              <span class="row-actions">
                {scene === "running" && <span class="link-sm">Stop All</span>}
                <svg class="refresh-icon" viewBox="0 0 20 20" width="13" height="13" aria-hidden="true">
                  <path
                    d="M16 10a6 6 0 1 1-1.8-4.3M16 3v4h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>
          )}

          {showEmptyRunning && (
            <div class="empty-running">
              <MoleArt pose="mound" width={64} alt="" decorative />
              <p class="muted">Nothing running right now</p>
              <span class="doodle">zzz···</span>
            </div>
          )}

          {scene === "running" && (
            <>
              <ul class="proj-list">
                <li>
                  <span class="proj-folder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16">
                      <rect x="2" y="7" width="20" height="13" rx="2.5" fill="var(--folder-blue)" />
                      <path d="M2 7 L2 5 a2 2 0 0 1 2-2 h5 l2 2.5 h9 a2 2 0 0 1 2 2" fill="var(--folder-blue-deep)" />
                    </svg>
                  </span>
                  <span class="proj-text">
                    <span class="proj-name">portfolio-site</span>
                    <span class="proj-meta muted">localhost:5173 · Vite · Running · 12 min</span>
                  </span>
                  <span class="proj-icons">
                    <span class="proj-pin" aria-hidden="true">☆</span>
                    <span class="proj-stop" aria-hidden="true">✕</span>
                  </span>
                </li>
                <li>
                  <span class="proj-folder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16">
                      <rect x="2" y="7" width="20" height="13" rx="2.5" fill="var(--folder-blue)" />
                      <path d="M2 7 L2 5 a2 2 0 0 1 2-2 h5 l2 2.5 h9 a2 2 0 0 1 2 2" fill="var(--folder-blue-deep)" />
                    </svg>
                  </span>
                  <span class="proj-text">
                    <span class="proj-name">recipe-app</span>
                    <span class="proj-meta muted">localhost:3000 · Next.js · Running · 4 min</span>
                  </span>
                  <span class="proj-icons">
                    <span class="proj-pin is-pinned" aria-hidden="true">★</span>
                    <span class="proj-stop" aria-hidden="true">✕</span>
                  </span>
                </li>
                <li>
                  <span class="proj-folder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16">
                      <rect x="2" y="7" width="20" height="13" rx="2.5" fill="var(--folder-blue)" />
                      <path d="M2 7 L2 5 a2 2 0 0 1 2-2 h5 l2 2.5 h9 a2 2 0 0 1 2 2" fill="var(--folder-blue-deep)" />
                    </svg>
                  </span>
                  <span class="proj-text">
                    <span class="proj-name">design-system</span>
                    <span class="proj-meta muted">localhost:8080 · static · Running · 1 min</span>
                  </span>
                  <span class="proj-icons">
                    <span class="proj-pin" aria-hidden="true">☆</span>
                    <span class="proj-stop" aria-hidden="true">✕</span>
                  </span>
                </li>
              </ul>
              <div class="autoclose-row autoclose-row--compact muted">
                Auto Close <b>2 hours</b>
              </div>
            </>
          )}

          {scene === "settings" && (
            <div class="settings-mock">
              <div class="settings-tabs">
                <span class="is-active">General</span>
                <span>Story</span>
                <span>About</span>
              </div>
              <div class="settings-row">
                <span>Auto Close</span>
                <span class="muted">2 hours (default)</span>
              </div>
              <div class="settings-row">
                <span>Open browser automatically</span>
                <span class="toggle is-on" aria-hidden="true"></span>
              </div>
              <div class="settings-row">
                <span>Language</span>
                <span class="muted">English</span>
              </div>
              <div class="settings-about muted">
                Mole v1.0.4 · MIT License · github.com/ST6AR1/mole
              </div>
            </div>
          )}
        </div>
        <span class="mock-tag-corner">Screenshot placeholder</span>
      </div>
    )
  }
</figure>

<style>
  .app-frame {
    margin: 0;
    width: 100%;
    max-width: 460px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-warm);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-window);
  }

  /* Only the direct-child real screenshot <Image> should stretch to fill the
     frame — mascot <img>s nested inside the mock (drop-mole, pawprints, the
     corner wrench, etc.) must keep their own explicit `width` prop size. */
  .app-frame > :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .mock {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface-warm);
    font-size: 0.8rem;
  }

  .mock-titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
  }

  .tl {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .tl-red {
    background: #ff5f56;
  }
  .tl-yellow {
    background: #ffbd2e;
  }
  .tl-green {
    background: #27c93f;
  }

  .mock-word {
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-left: 6px;
    color: var(--text);
  }

  .mock-tag {
    font-size: 0.6875rem;
    color: var(--text-faint);
    margin-left: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* :global() — MoleArt's <img> lives outside this file's style scope. */
  .mock-titlebar :global(.mock-corner-mole) {
    margin-left: auto;
    width: 22px;
    height: auto;
    flex: 0 0 auto;
  }

  .mock-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: color-mix(in srgb, var(--butter) 35%, var(--surface-warm));
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    flex-wrap: wrap;
  }
  .mock-banner-ver {
    color: var(--text-muted);
  }
  .mock-banner-cta {
    margin-left: auto;
    font-weight: 600;
    color: var(--soil);
    text-decoration: underline;
  }

  .mock-body {
    flex: 1;
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .drop-zone-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .drag-doodle {
    position: absolute;
    top: -6px;
    right: 34px;
    font-size: 1.05rem;
    z-index: 1;
  }

  .drag-arrow {
    position: absolute;
    top: 14px;
    right: 4px;
    z-index: 1;
  }

  .drop-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
    border: 1.5px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 22px 16px 18px;
    background: var(--surface);
    transition:
      border-color var(--dur-med) var(--ease-out),
      background var(--dur-med) var(--ease-out);
  }

  .drop-zone.is-hover {
    border-color: var(--folder-blue-deep);
    border-style: solid;
    background: color-mix(in srgb, var(--folder-blue) 12%, var(--surface));
  }

  /* :global() — MoleArt's <img> lives outside this file's style scope. */
  .drop-zone :global(.drop-mole) {
    margin-bottom: 4px;
  }

  .drop-zone-wrap :global(.drop-prints) {
    align-self: flex-start;
    margin-top: 6px;
    opacity: 0.8;
  }

  .drop-title {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .drop-sub {
    font-size: 0.75rem;
  }

  .pill-btn {
    margin-top: 8px;
    display: inline-block;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    background: var(--soil);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .detect-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px;
    flex: 1;
  }
  .detect-card :global(.detect-mole) {
    flex: 0 0 auto;
  }
  .detect-text {
    min-width: 0;
  }
  .detect-title {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .detect-sub {
    font-size: 0.75rem;
    margin-top: 2px;
  }
  .detect-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.75rem;
  }
  .detect-list li {
    padding-left: 18px;
    position: relative;
    color: var(--text-muted);
  }
  .detect-list li b {
    color: var(--text);
    font-weight: 600;
  }
  .detect-list li.done::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--sage);
    font-weight: 700;
  }
  .detect-list li.pending::before {
    content: "•";
    position: absolute;
    left: 3px;
    color: var(--text-faint);
  }

  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 0.875rem;
  }
  .row-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-faint);
  }
  .refresh-icon {
    color: var(--text-faint);
  }
  .link-sm {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--danger);
  }

  .empty-running {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    padding: 14px 0 6px;
  }
  .empty-running p {
    font-size: 0.8125rem;
    margin-top: 2px;
  }
  .empty-running .doodle {
    font-size: 0.9375rem;
  }

  .proj-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .proj-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .proj-folder {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
  }
  .proj-text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .proj-name {
    font-weight: 600;
    font-size: 0.8125rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .proj-meta {
    font-size: 0.6875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .proj-icons {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .proj-pin,
  .proj-stop {
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--text-faint);
  }
  .proj-pin.is-pinned {
    color: var(--butter);
    filter: saturate(2) brightness(0.85);
  }
  .proj-stop {
    color: var(--danger);
    opacity: 0.7;
  }

  .autoclose-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 0.75rem;
  }
  .autoclose-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-weight: 600;
  }
  .autoclose-label .muted {
    font-weight: 400;
    font-size: 0.6875rem;
  }
  .dropdown-pill {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: 0.6875rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .autoclose-row--compact {
    padding-top: 4px;
    border-top: 1px solid var(--border);
    font-weight: 400;
  }
  .autoclose-row--compact b {
    color: var(--text);
    font-weight: 600;
  }

  .settings-mock {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .settings-tabs {
    display: flex;
    gap: 16px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-faint);
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  .settings-tabs .is-active {
    color: var(--text);
    border-bottom: 2px solid var(--soil);
    padding-bottom: 8px;
    margin-bottom: -9px;
  }
  .settings-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    padding: 6px 0;
  }
  .toggle {
    width: 30px;
    height: 17px;
    border-radius: var(--radius-pill);
    background: var(--border-strong);
    position: relative;
  }
  .toggle.is-on {
    background: var(--sage);
  }
  .toggle::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #fff;
  }
  .toggle.is-on::after {
    left: 15px;
  }
  .settings-about {
    font-size: 0.6875rem;
    padding-top: 8px;
    border-top: 1px solid var(--border);
  }

  .mock-tag-corner {
    position: absolute;
    bottom: 8px;
    right: 10px;
    font-size: 0.625rem;
    color: var(--text-faint);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }
</style>
