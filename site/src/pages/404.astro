---
// GitHub Pages serves this single root 404.html for any unmatched path,
// regardless of locale — it can't know which locale the visitor wanted, so
// it always renders in the default locale (English).
import BaseLayout from "../layouts/BaseLayout.astro";
import MoleArt from "../components/MoleArt.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getDictionary, defaultLocale } from "../i18n";

const dict = getDictionary(defaultLocale);
---

<BaseLayout
  title="Page not found — Mole"
  description="This page doesn't exist."
  routePath="/404"
  locale={defaultLocale}
>
  <main id="main" class="not-found">
    <div class="not-found-inner">
      <MoleArt pose="mound" width={140} alt="An empty dirt mound — Mole isn't here" />
      <h1>{dict.notFound.heading}</h1>
      <p class="muted">{dict.notFound.body}</p>
      <a class="home-link" href={getRelativeLocaleUrl(defaultLocale, "/")}>{dict.notFound.cta}</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-16) var(--content-pad);
  }

  .not-found-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .not-found-inner h1 {
    margin-top: var(--sp-4);
  }

  .home-link {
    margin-top: var(--sp-6);
    display: inline-flex;
    padding: 0.75em 1.5em;
    border-radius: var(--radius-pill);
    background: var(--soil);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
</style>
