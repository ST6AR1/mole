---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getDictionary } from "../i18n";
import { getLatestRelease } from "../data/release";
import { REPO_URL } from "../utils/url";

const dict = getDictionary();
const release = await getLatestRelease();
---

<BaseLayout
  title="Privacy — Mole"
  description="Mole runs entirely on your own machine. Here's exactly what it does and doesn't send over the network."
  path="/privacy"
>
  <Header dict={dict} />
  <main id="main">
    <section class="section">
      <div class="container container--narrow prose">
        <h1>Privacy</h1>
        <p class="muted">
          Mole runs entirely on your own machine. It doesn't collect or
          upload any usage data or project content.
        </p>

        <h2>The only network calls Mole makes</h2>
        <ul>
          <li>
            Checking GitHub for a newer version on launch — a read-only call
            to the public Releases API. No device info is sent.
          </li>
          <li>
            Opening a pre-filled GitHub Issue page, only when you click
            “Report an Issue” yourself.
          </li>
        </ul>

        <h2>This website</h2>
        <p>
          This site has no analytics, no tracking pixels, and no cookies
          beyond what your browser sets for itself. Release and star-count
          numbers shown here are fetched from the public GitHub API when the
          site is built.
        </p>

        <p class="muted">
          Questions? Open an issue on
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>.
        </p>
      </div>
    </section>
  </main>
  <Footer dict={dict} release={release} />
</BaseLayout>

<style>
  .container--narrow {
    max-width: 680px;
  }

  .prose h1 {
    margin-bottom: var(--sp-6);
  }

  .prose h2 {
    margin-top: var(--sp-12);
    margin-bottom: var(--sp-3);
    font-size: 1.25rem;
  }

  .prose p,
  .prose li {
    color: var(--text-muted);
    line-height: var(--lh-body);
  }

  .prose ul {
    padding-left: 1.25em;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .prose a {
    color: var(--soil);
  }
</style>
