---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import LogoBand from "../components/LogoBand.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Solution from "../components/Solution.astro";
import Features from "../components/Features.astro";
import MoleMoment from "../components/MoleMoment.astro";
import VibeCoding from "../components/VibeCoding.astro";
import OpenSource from "../components/OpenSource.astro";
import DownloadCta from "../components/DownloadCta.astro";
import Footer from "../components/Footer.astro";
import { getDictionary, defaultLocale } from "../i18n";
import { getLatestRelease, getStarCount } from "../data/release";

const locale = Astro.currentLocale ?? defaultLocale;
const dict = getDictionary(locale);
const [release, stars] = await Promise.all([
  getLatestRelease(),
  getStarCount(),
]);
---

<BaseLayout
  title={dict.meta.title}
  description={dict.meta.description}
  routePath="/"
  locale={locale}
>
  <Header dict={dict} locale={locale} routePath="/" />
  <LogoBand />
  <main id="main">
    <Hero dict={dict} release={release} />
    <Problem dict={dict} />
    <Solution dict={dict} />
    <Features dict={dict} />
    <MoleMoment dict={dict} />
    <VibeCoding dict={dict} />
    <OpenSource dict={dict} stars={stars} locale={locale} />
    <DownloadCta dict={dict} release={release} />
  </main>
  <Footer dict={dict} release={release} locale={locale} />
</BaseLayout>
