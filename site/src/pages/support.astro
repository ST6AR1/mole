---
// Support Mole — a dedicated, low-pressure page for optional donations.
// One flat list of methods (src/i18n/en.ts: support.methods): each entry
// is either live (ready: true, highlighted, clickable if it has an href,
// or the WeChat QR block if `qr: true`) or still pending (ready: false,
// muted, tagged "Preparing"). Flip `ready` and add `href` to go live.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MoleArt from "../components/MoleArt.astro";
import { getDictionary } from "../i18n";
import { getLatestRelease } from "../data/release";
import { withBase } from "../utils/url";
import wechatQr from "../assets/support/wechat-qr.png";

const dict = getDictionary();
const release = await getLatestRelease();
---

<BaseLayout
  title={`${dict.support.metaTitle} — Mole`}
  description={dict.support.metaDescription}
  path="/support"
>
  <Header dict={dict} />
  <main id="main">
    <section class="section">
      <div class="container container--narrow support-head reveal">
        <MoleArt pose="wrench" width={72} alt="Mole holding a wrench" />
        <h1>{dict.support.heading}</h1>
        <p class="muted">{dict.support.intro}</p>
      </div>

      <div class="container container--narrow">
        <h2 class="methods-heading reveal">{dict.support.methodsHeading}</h2>

        <div class="methods-grid">
          {
            dict.support.methods.map((m, i) =>
              m.qr ? (
                <div
                  class:list={["method-card", "method-card--qr", "reveal", { "is-ready": m.ready }]}
                  style={`transition-delay:${i * 60}ms`}
                >
                  <Image src={wechatQr} alt="WeChat Pay reward QR code" width={140} loading="lazy" />
                  <span class="method-label">{m.label}</span>
                  {m.qrCaption && <span class="qr-caption muted">{m.qrCaption}</span>}
                </div>
              ) : m.ready && m.href ? (
                <a
                  href={m.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="method-card is-ready reveal"
                  style={`transition-delay:${i * 60}ms`}
                >
                  <span class="method-label">{m.label}</span>
                </a>
              ) : (
                <div class="method-card reveal" style={`transition-delay:${i * 60}ms`}>
                  <span class="method-label">{m.label}</span>
                  <span class="preparing-badge">{dict.support.preparing}</span>
                </div>
              ),
            )
          }
        </div>

        <div class="contact-block reveal">
          <h3>{dict.support.contactHeading}</h3>
          <p class="muted">{dict.support.contactBody}</p>
          <a class="contact-email" href={`mailto:${dict.support.contactEmail}`}>
            {dict.support.contactEmail}
          </a>
        </div>
      </div>

      <div class="container container--narrow support-footer reveal">
        <p class="muted">{dict.support.footnote}</p>
        <a class="back-link" href={withBase("/")}>
          ← {dict.support.backHome}
        </a>
      </div>
    </section>
  </main>
  <Footer dict={dict} release={release} />
</BaseLayout>

<style>
  .support-head {
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: var(--sp-16);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .support-head h1 {
    margin-top: var(--sp-2);
  }

  .methods-heading {
    text-align: center;
    margin-bottom: var(--sp-8);
  }

  .methods-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-4);
  }

  .method-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-1);
    min-width: 140px;
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-warm);
    text-decoration: none;
    color: var(--text-muted);
  }

  .method-card.is-ready {
    background: color-mix(in srgb, var(--folder-blue) 12%, var(--surface));
    border-color: var(--folder-blue);
  }

  a.method-card.is-ready {
    transition:
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  a.method-card.is-ready:hover {
    background: color-mix(in srgb, var(--folder-blue) 24%, var(--surface));
    transform: translateY(-2px);
  }

  .method-card.is-ready .method-label {
    color: var(--soil);
    font-weight: 700;
  }

  .method-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .preparing-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .method-card--qr {
    padding-block: var(--sp-3);
  }

  .method-card--qr :global(img) {
    width: 100px;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    margin-bottom: var(--sp-2);
  }

  .qr-caption {
    font-size: 0.6875rem;
  }

  .contact-block {
    text-align: center;
    max-width: 440px;
    margin: var(--sp-16) auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
  }

  .contact-block h3 {
    font-size: 1.0625rem;
  }

  .contact-email {
    margin-top: var(--sp-1);
    font-weight: 600;
    color: var(--soil);
    text-decoration: none;
    border-bottom: 1px solid var(--folder-blue);
  }

  .contact-email:hover {
    color: var(--soil-hover);
  }

  .support-footer {
    text-align: center;
    max-width: 480px;
    margin-inline: auto;
    margin-top: var(--sp-16);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .back-link {
    font-weight: 600;
    color: var(--soil);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .method-card {
      min-width: 0;
      flex: 1 1 calc(50% - var(--sp-4));
    }
  }
</style>
