---
// Support Mole — a dedicated, low-pressure page for optional donations.
// One flat list of methods (src/i18n/en.ts: support.methods): each entry
// is either live (ready: true, highlighted, clickable if it has an href,
// or the WeChat QR block if `qr: true`) or still pending (ready: false,
// muted, tagged "Preparing"). Flip `ready` and add `href` to go live.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MoleArt from "../components/MoleArt.astro";
import { getDictionary } from "../i18n";
import { getLatestRelease } from "../data/release";
import { withBase } from "../utils/url";
import wechatQr from "../assets/support/wechat-qr.png";

const dict = getDictionary();
const release = await getLatestRelease();
---

<BaseLayout
  title={`${dict.support.metaTitle} — Mole`}
  description={dict.support.metaDescription}
  path="/support"
>
  <Header dict={dict} />
  <main id="main">
    <section class="section">
      <div class="container container--narrow support-head reveal">
        <MoleArt pose="wrench" width={72} alt="Mole holding a wrench" />
        <h1>{dict.support.heading}</h1>
        <p class="muted">{dict.support.intro}</p>
      </div>

      <div class="container container--narrow">
        <h2 class="methods-heading reveal">{dict.support.methodsHeading}</h2>

        <ul class="methods-list">
          {
            dict.support.methods.map((m, i) =>
              m.qr ? (
                <li class:list={["method-row", "reveal", { "is-ready": m.ready }]} style={`transition-delay:${i * 60}ms`}>
                  <details class="method-details">
                    <summary>
                      <span class="method-label">{m.label}</span>
                      <span class="method-arrow" aria-hidden="true">+</span>
                    </summary>
                    <div class="method-qr">
                      <Image src={wechatQr} alt="WeChat Pay reward QR code" width={140} loading="lazy" />
                      {m.qrCaption && <span class="qr-caption muted">{m.qrCaption}</span>}
                    </div>
                  </details>
                </li>
              ) : m.href ? (
                <li class:list={["method-row", "reveal", { "is-ready": m.ready }]} style={`transition-delay:${i * 60}ms`}>
                  <a href={m.href} target="_blank" rel="noopener noreferrer">
                    <span class="method-label">{m.label}</span>
                    {m.ready ? (
                      <span class="method-arrow" aria-hidden="true">→</span>
                    ) : (
                      <span class="preparing-badge">{dict.support.preparing}</span>
                    )}
                  </a>
                </li>
              ) : (
                <li class="method-row reveal" style={`transition-delay:${i * 60}ms`}>
                  <span class="method-row-static">
                    <span class="method-label">{m.label}</span>
                    <span class="preparing-badge">{dict.support.preparing}</span>
                  </span>
                </li>
              ),
            )
          }
        </ul>

        <div class="contact-block reveal">
          <p class="muted">{dict.support.contactBody}</p>
          <a class="contact-email" href={`mailto:${dict.support.contactEmail}`}>
            {dict.support.contactEmail}
          </a>
        </div>
      </div>

      <div class="container container--narrow support-footer reveal">
        <p class="muted">{dict.support.footnote}</p>
        <a class="back-link" href={withBase("/")}>
          ← {dict.support.backHome}
        </a>
      </div>
    </section>
  </main>
  <Footer dict={dict} release={release} />
</BaseLayout>

<style>
  .support-head {
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: var(--sp-16);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .support-head h1 {
    margin-top: var(--sp-2);
  }

  .methods-heading {
    text-align: center;
    margin-bottom: var(--sp-8);
  }

  .methods-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .method-row {
    border-bottom: 1px solid var(--border);
  }

  .method-row > a,
  .method-row > .method-row-static,
  .method-row .method-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-2);
    text-decoration: none;
    color: var(--text-muted);
    cursor: default;
  }

  .method-row > a,
  .method-row .method-details summary {
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .method-row > a:hover,
  .method-row .method-details summary:hover {
    background: color-mix(in srgb, var(--text) 4%, transparent);
  }

  .method-row.is-ready .method-label {
    color: var(--soil);
    font-weight: 700;
  }

  .method-row.is-ready {
    background: color-mix(in srgb, var(--butter) 14%, transparent);
  }

  .method-row.is-ready > a,
  .method-row.is-ready .method-details summary {
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .method-row.is-ready > a:hover,
  .method-row.is-ready .method-details summary:hover {
    background: color-mix(in srgb, var(--butter) 26%, transparent);
  }

  .method-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .method-arrow {
    display: inline-block;
    color: var(--soil-light);
    font-size: 1.125rem;
    line-height: 1;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .preparing-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .method-details summary {
    list-style: none;
  }
  .method-details summary::-webkit-details-marker {
    display: none;
  }
  .method-details[open] summary .method-arrow {
    transform: rotate(45deg);
  }

  .method-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    padding: 0 var(--sp-2) var(--sp-5);
  }

  .method-qr :global(img) {
    width: 140px;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .qr-caption {
    font-size: 0.75rem;
  }

  .contact-block {
    text-align: center;
    max-width: 440px;
    margin: var(--sp-16) auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
  }

  .contact-email {
    margin-top: var(--sp-1);
    font-weight: 600;
    color: var(--soil);
    text-decoration: none;
    border-bottom: 1px solid var(--soil-light);
  }

  .contact-email:hover {
    color: var(--soil-hover);
  }

  .support-footer {
    text-align: center;
    max-width: 480px;
    margin-inline: auto;
    margin-top: var(--sp-16);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .back-link {
    font-weight: 600;
    color: var(--soil);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
